{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "C5 教学楼室内导航 MVP 接口",
        "title": "C5 Indoor Navigation API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/nearby": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "nearby"
                ],
                "summary": "查询最近设施",
                "parameters": [
                    {
                        "type": "string",
                        "example": "C5",
                        "description": "楼栋编码",
                        "name": "building",
                        "in": "query",
                        "required": true
                    },
                    {
                        "enum": [
                            "F1",
                            "F2",
                            "F3",
                            "F4",
                            "F5"
                        ],
                        "type": "string",
                        "description": "楼层",
                        "name": "floor",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "101",
                        "description": "起点教室房号",
                        "name": "room_no",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "restroom,elevator,stairs,exit,water",
                        "description": "设施类型，逗号分隔",
                        "name": "types",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "F1,F2",
                        "description": "允许楼层，逗号分隔",
                        "name": "allowed_floors",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/indoor-navigation_backend_internal_dto.NearbyResponseEnvelope"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/indoor-navigation_backend_internal_dto.ErrorEnvelope"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/indoor-navigation_backend_internal_dto.ErrorEnvelope"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/indoor-navigation_backend_internal_dto.ErrorEnvelope"
                        }
                    }
                }
            }
        },
