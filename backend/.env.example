APP_ENV=dev
APP_PORT=8080
BUILDING_CODE=C5

# MySQL 连接串（启动加载内存图必需）
MYSQL_DSN=user:password@tcp(127.0.0.1:3306)/c5_navigation?charset=utf8mb4&parseTime=True&loc=Local

# Redis（路线缓存）
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# 路线缓存 TTL：基础 900 秒 + 0–300 秒抖动
ROUTE_CACHE_TTL_SECONDS=900
ROUTE_CACHE_JITTER_SECONDS=300

# 日志落盘与轮转
LOG_LEVEL=info
LOG_DIR=logs
LOG_FILE=app.log
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=7
LOG_MAX_AGE_DAYS=14
LOG_COMPRESS=true
